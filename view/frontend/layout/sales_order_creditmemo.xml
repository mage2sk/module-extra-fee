<?xml version="1.0"?>
<!--
/**
 * Customer credit memo view layout: extra fee totals
 *
 * @category  Panth
 * @package   Panth_ExtraFee
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="creditmemo_totals">
            <block class="Panth\ExtraFee\Block\Sales\Order\Totals\ExtraFee"
                   name="panth.extra.fee.creditmemo.totals"
                   after="tax">
                <arguments>
                    <argument name="display_area" xsi:type="string">creditmemo</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
