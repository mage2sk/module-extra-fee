<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_quote_save_after">
        <observer name="panth_extra_fee_persist_pending_quote_fees" instance="Panth\ExtraFee\Observer\PersistPendingQuoteFees"/>
    </event>
    <event name="checkout_submit_all_after">
        <observer name="panth_extra_fee_save_order_fees" instance="Panth\ExtraFee\Observer\SaveOrderFees"/>
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="panth_extra_fee_save_order_fees_on_submit" instance="Panth\ExtraFee\Observer\SaveOrderFees"/>
    </event>
    <event name="sales_order_invoice_register">
        <observer name="panth_extra_fee_register_invoice_fees" instance="Panth\ExtraFee\Observer\RegisterInvoiceFees"/>
    </event>
    <event name="sales_order_creditmemo_refund">
        <observer name="panth_extra_fee_register_creditmemo_fees" instance="Panth\ExtraFee\Observer\RegisterCreditmemoFees"/>
    </event>
</config>
